# Copy this file to .env and fill in the values. Never commit .env.

# ── Database / services ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SARVAM_API_KEY=
# Used only for menu-search embeddings (all-MiniLM-L6-v2). Keep this model —
# the Milvus collection was built with it.
HUGGINGFACE_TOKEN=

# ── Chat LLM ─────────────────────────────────────────────────────────────────
# Any OpenAI-compatible provider works. To switch, uncomment ONE block below
# and comment out the others. No code change needed.

# --- Ollama Cloud (testing) ---
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss:20b
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.5

# --- Groq ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low
# LLM_TEMPERATURE=0.5

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-5-nano
# LLM_REASONING_EFFORT=low
# LLM_MAX_TOKENS_FIELD=max_completion_tokens

# --- Google Gemini ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TEMPERATURE=0.5

# ── Optional tuning (defaults shown) ─────────────────────────────────────────
# Cheaper model for greet/faq replies; defaults to LLM_MODEL.
# LLM_SMALL_MODEL=
# Max reply tokens, including the model's hidden reasoning.
# LLM_MAX_TOKENS=1024
# Name of the reply-limit field: max_tokens (Ollama, Groq, Gemini, most others)
# or max_completion_tokens (OpenAI).
# LLM_MAX_TOKENS_FIELD=max_tokens
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2
